# agemail – sample environment configuration
# Copy to .env (or export vars) and fill in your values.
# All variables are optional; shown values are the defaults unless noted.

# ── Server ────────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080

# ── Proof of Work ─────────────────────────────────────────────────────────────
# Browsers must solve a small hash puzzle per request (token in X-PoW header).
# Cheap for legit users, expensive for spammers. Difficulty N ≈ 2^N hashes,
# so each +1 roughly doubles browser solve time.
# Difficulty for /api/lookup (recipient key discovery). Kept low so the UI
# stays snappy — one lookup happens per recipient badge.
POW_DIFFICULTY=16
# Separate, higher difficulty for /api/send. Sending costs real resources
# (SMTP/Cloudflare relay) and is abuse-prone, so it demands more work.
POW_DIFFICULTY_MAIL_SEND=20
# Seconds a solved token stays valid. Prevents stockpiling pre-solved tokens;
# also sizes the server-side replay cache (TTL = 2x this value).
POW_VALIDITY_SECONDS=60

# ── DNS / key discovery ───────────────────────────────────────────────────────
# Leave empty to use the system resolver. Set to a validating resolver (e.g.
# 1.1.1.1:53 or 8.8.8.8:53) to get DNSSEC trust upgrades.
DNS_RESOLVER=
WELLKNOWN_TIMEOUT_SECONDS=5

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins permitted for API requests. Empty means same-origin
# is inferred from the Host header (fine for local dev). Behind a reverse
# proxy, set the external origin(s), e.g. https://age.example.com
CORS_ALLOWED_ORIGINS=

# ══════════════════════════════════════════════════════════════════════════════
# Mail backend – choose ONE of the two sections below and set MAIL_BACKEND.
# ══════════════════════════════════════════════════════════════════════════════

# ── Option A: SMTP (default) ──────────────────────────────────────────────────
MAIL_BACKEND=smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
SMTP_FROM=noreply@example.com

# ── Option B: Cloudflare Email API ────────────────────────────────────────────
# Requires a domain onboarded in Cloudflare Email Sending and an API token with
# the "Email Sending: Edit" permission.
# See: https://developers.cloudflare.com/email-service/get-started/send-emails/
#
# MAIL_BACKEND=cloudflare
#
# CF_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# CF_API_TOKEN=your-cloudflare-api-token
# CF_FROM=noreply@yourdomain.com
